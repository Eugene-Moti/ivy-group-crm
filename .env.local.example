# Supabase project settings — find these in Project Settings > API
# in your Supabase dashboard (https://supabase.com/dashboard).

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project API keys > anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project API keys > service_role key (SERVER-ONLY — never expose to the browser,
# never prefix with NEXT_PUBLIC_). Used for privileged admin operations only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API key (SERVER-ONLY) — powers the AI Assistant. Free at
# https://console.groq.com/keys, no card required. Never sent any data
# anywhere except Groq's inference API for the duration of a chat request.
GROQ_API_KEY=your-groq-api-key

# Optional: override the Groq model the assistant uses. Defaults to
# llama-3.3-70b-versatile if unset.
# GROQ_MODEL=llama-3.3-70b-versatile
