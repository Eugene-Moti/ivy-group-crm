# Supabase project settings — find these in Project Settings > API
# in your Supabase dashboard (https://supabase.com/dashboard).

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project API keys > anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project API keys > service_role key (SERVER-ONLY — never expose to the browser,
# never prefix with NEXT_PUBLIC_). Used for privileged admin operations only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API key (SERVER-ONLY) — powers the AI Assistant. Free at
# https://console.groq.com/keys, no card required. Never sent any data
# anywhere except Groq's inference API for the duration of a chat request.
GROQ_API_KEY=your-groq-api-key

# Optional: override the Groq model the assistant uses. Defaults to
# llama-3.3-70b-versatile if unset.
# GROQ_MODEL=llama-3.3-70b-versatile

# Resend API key (SERVER-ONLY) — sends the daily AI briefing email to
# admins. Free at https://resend.com/api-keys (~3,000 emails/month, no
# card required). Without it, the digest cron route just returns a 503 —
# nothing else in the app depends on this.
RESEND_API_KEY=your-resend-api-key

# Optional: the "from" address for the daily briefing. Defaults to Resend's
# shared sandbox sender, which can only deliver to the email on your Resend
# account — verify a domain in Resend and set this to an address on it
# (e.g. "Ivy Group CRM <digest@yourdomain.com>") to actually reach your
# admins' real inboxes.
# DIGEST_FROM_EMAIL=Ivy Group CRM <digest@yourdomain.com>

# Shared secret (SERVER-ONLY) protecting /api/cron/digest from being
# triggered by anyone else — generate any random string (e.g.
# `openssl rand -hex 32`). Vercel Cron automatically sends this as a Bearer
# token when CRON_SECRET is set as an environment variable on the project.
CRON_SECRET=your-random-secret

# Shared secret (SERVER-ONLY) protecting /api/webhooks/leads — the inbound
# lead-capture endpoint (a website form's own backend, or a Zapier/Make
# bridge in front of Facebook/Instagram Lead Ads). Generate any random
# string (e.g. `openssl rand -hex 32`); callers send it as
# `Authorization: Bearer <this value>`. NEVER put this in client-side/
# browser JS on a public website — see README for the safe way to wire it up.
LEAD_WEBHOOK_SECRET=your-random-secret
