# Supabase project settings — find these in Project Settings > API
# in your Supabase dashboard (https://supabase.com/dashboard).

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project API keys > anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project API keys > service_role key (SERVER-ONLY — never expose to the browser,
# never prefix with NEXT_PUBLIC_). Used for privileged admin operations only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key (SERVER-ONLY) — powers Orion everywhere in the app: the
# top-bar quick trigger, the full /orion page (Portfolio Briefing + deep-dive
# chat), and the daily briefing email below. Get one at
# https://console.anthropic.com/settings/keys. Without it, every Orion route
# returns a clean "not configured" message instead of erroring.
ANTHROPIC_API_KEY=your-anthropic-api-key

# SMTP credentials (SERVER-ONLY) — send Orion's daily briefing email to
# admins. Works with any SMTP provider; Gmail is the easiest free option to
# start with:
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords (choose
#      "Mail" as the app) — it gives you a 16-character password, NOT your
#      normal Gmail password.
#   3. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your full Gmail
#      address, SMTP_PASS=that 16-character App Password.
# Gmail caps free sending around 500/day, which is more than enough for one
# daily email to a handful of admins. Without these set, the digest cron
# route just returns a 503 — nothing else in the app depends on this.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Optional: the "from" address for the daily briefing. Defaults to SMTP_USER
# if unset. With Gmail, this should generally match SMTP_USER — Gmail
# rewrites/rejects a "from" address it doesn't own.
# SMTP_FROM=Ivy Group CRM <your-gmail-address@gmail.com>

# Shared secret (SERVER-ONLY) protecting /api/cron/digest from being
# triggered by anyone else — generate any random string (e.g.
# `openssl rand -hex 32`). Vercel Cron automatically sends this as a Bearer
# token when CRON_SECRET is set as an environment variable on the project.
CRON_SECRET=your-random-secret

# Shared secret (SERVER-ONLY) protecting /api/webhooks/leads — the inbound
# lead-capture endpoint (a website form's own backend, or a Zapier/Make
# bridge in front of Facebook/Instagram Lead Ads). Generate any random
# string (e.g. `openssl rand -hex 32`); callers send it as
# `Authorization: Bearer <this value>`. NEVER put this in client-side/
# browser JS on a public website — see README for the safe way to wire it up.
LEAD_WEBHOOK_SECRET=your-random-secret

# Signs the short-lived "second factor cleared" cookie used by the login PIN
# below. Generate any random string, 32+ chars (e.g. `openssl rand -base64
# 32`). Server-only.
PRIVATE_UNLOCK_SECRET=your-random-secret

# Mandatory post-password 2FA on the main login: a PIN each user sets once
# (6-12 digits, scrypt-hashed, 5-attempt lockout) — fully self-contained, no
# email service or domain needed. Nothing to configure beyond running its
# migration. Kill switch below.
#
# Leave unset for normal operation (2FA enforced for everyone). Set to
# exactly "true" ONLY to disable it in an emergency, then redeploy.
# Password login still applies.
# DISABLE_LOGIN_2FA=true
